{
  "name": "agents-office-tower-vscode",
  "displayName": "Agents Office Tower",
  "description": "Room-based activity view for agent sessions and cloud tasks across supported providers.",
  "version": "0.1.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kundara/AgentsOfficeTower.git",
    "directory": "packages/vscode"
  },
  "publisher": "local",
  "engines": {
    "vscode": "^1.97.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:codexAgentsOffice.view",
    "onCommand:codexAgentsOffice.refresh",
    "onCommand:codexAgentsOffice.openRoomsXml",
    "onCommand:codexAgentsOffice.scaffoldRoomsXml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codexAgentsOffice",
          "title": "Agents Office Tower",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "codexAgentsOffice": [
        {
          "id": "codexAgentsOffice.view",
          "name": "Agents Office Tower",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "codexAgentsOffice.refresh",
        "title": "Agents Office Tower: Refresh"
      },
      {
        "command": "codexAgentsOffice.openRoomsXml",
        "title": "Agents Office Tower: Open Rooms XML"
      },
      {
        "command": "codexAgentsOffice.scaffoldRoomsXml",
        "title": "Agents Office Tower: Scaffold Rooms XML"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agents-tower/core": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/vscode": "^1.97.0"
  }
}
